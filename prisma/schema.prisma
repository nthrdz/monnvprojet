// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sport {
  RUNNING
  CYCLING
  TRIATHLON
  SWIMMING
  SKIING
  OTHER
}

enum PlanType {
  FREE
  PRO
  ELITE
  ATHLETE_PRO
  COACH
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?   // Optionnel pour les connexions OAuth (Google, etc.)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Réinitialisation du mot de passe
  resetPasswordToken    String?   @unique
  resetPasswordExpires  DateTime?
  
  profile       Profile?
  accounts      Account[]
  sessions      Session[]
  
  // Système d'affiliation
  affiliate     Affiliate?
  referredBy    Referral[] @relation("ReferredUser")
}

model Profile {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Basic Info
  username        String    @unique
  displayName     String
  bio             String?   @db.Text
  sport           Sport     @default(RUNNING)
  location        String?
  avatarUrl       String?
  coverUrl        String?
  
  // Plan
  plan            PlanType  @default(FREE)
  customDomain    String?   @unique
  
  // Stats Manuelles (Phase 1)
  stats           Json?     // {personalRecords: [], achievements: []}
  
  // Social Links
  instagram       String?
  twitter         String?
  strava          String?
  youtube         String?
  tiktok          String?
  telegram        String?
  whatsapp        String?
  
  // Settings
  isPublic        Boolean   @default(true)
  showCoachingOnProfile Boolean @default(false)
  theme           String    @default("runner-pro")
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  links           Link[]
  races           Race[]
  sponsors        Sponsor[]
  media           Media[]
  analytics       Analytics[]
}

model Link {
  id          String    @id @default(cuid())
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  title       String
  url         String
  description String?
  icon        String?   // emoji ou icon name
  position    Int       @default(0)
  clicks      Int       @default(0)
  isActive    Boolean   @default(true)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([profileId])
}

model Race {
  id          String    @id @default(cuid())
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  name        String
  date        DateTime
  location    String?
  distance    String?   // "Marathon", "10K", etc.
  result      String?   // "2:18:45", "1st place", etc.
  status      String    @default("upcoming") // "upcoming", "completed"
  url         String?   // Lien inscription ou résultats
  logoUrl     String?   // Logo de l'événement
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([profileId])
}

model Sponsor {
  id          String    @id @default(cuid())
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  name        String
  logoUrl     String?
  websiteUrl  String?
  promoCode   String?
  description String?
  position    Int       @default(0)
  clicks      Int       @default(0)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([profileId])
}

model Media {
  id          String    @id @default(cuid())
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  type        String    // "image", "video", "youtube"
  url         String
  thumbnail   String?
  title       String?
  description String?
  position    Int       @default(0)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([profileId])
}

model Analytics {
  id          String    @id @default(cuid())
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  date        DateTime  @default(now())
  views       Int       @default(0)
  uniqueViews Int       @default(0)
  linkClicks  Int       @default(0)
  country     String?
  device      String?   // "mobile", "desktop"
  referrer    String?
  
  @@index([profileId, date])
}

// NextAuth Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Système d'affiliation avec Stripe Connect
model Affiliate {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Informations d'affiliation
  affiliateCode   String    @unique // Code unique pour les liens de parrainage
  status          AffiliateStatus @default(PENDING) // PENDING, APPROVED, SUSPENDED
  commissionRate  Float     @default(0.40) // 40% par défaut
  totalEarnings   Float     @default(0)
  totalReferrals  Int       @default(0)
  totalConversions Int      @default(0)
  totalClicks     Int       @default(0) // Nouveau: compteur de clics
  
  // Stripe Connect
  stripeAccountId String?   @unique // ID du compte Stripe Connect
  stripeAccountStatus String? // pending, active, suspended
  
  // Contact
  applicationEmail String?  // Email pour recevoir les notifications
  
  // Métadonnées
  approvedAt      DateTime?
  suspendedAt     DateTime?
  notes           String?   @db.Text
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  referrals       Referral[]
  commissions     Commission[]
  clicks          AffiliateClick[]
  
  @@index([affiliateCode])
  @@index([status])
  @@index([stripeAccountId])
}

// Nouveau: Tracking des clics
model AffiliateClick {
  id              String    @id @default(cuid())
  affiliateId     String
  affiliate       Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  
  // Tracking
  ipAddress       String?
  userAgent       String?
  referrerUrl     String?
  landingPage     String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  country         String?
  city            String?
  
  // Conversion
  converted       Boolean   @default(false)
  convertedAt     DateTime?
  referralId      String?   // Si converti, référence au Referral
  
  createdAt       DateTime  @default(now())
  
  @@index([affiliateId])
  @@index([createdAt])
  @@index([converted])
}

model Referral {
  id              String    @id @default(cuid())
  affiliateId     String
  affiliate       Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  
  // Utilisateur parrainé
  referredUserId  String?   // Peut être null si pas encore inscrit
  referredUser    User?     @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: SetNull)
  
  // Données du parrainage
  referralCode    String    // Code utilisé lors de l'inscription
  conversionType  ConversionType @default(SIGNUP) // SIGNUP, UPGRADE, PAYMENT
  status          ReferralStatus @default(PENDING) // PENDING, CONVERTED, EXPIRED
  
  // Stripe
  stripeCustomerId String?  // ID du client Stripe
  stripeSubscriptionId String? // ID de l'abonnement Stripe
  stripePaymentIntentId String? // ID du paiement Stripe
  
  // Tracking
  ipAddress       String?
  userAgent       String?
  referrerUrl     String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  
  // Conversion
  convertedAt     DateTime?
  conversionValue Float?    // Valeur de la conversion (prix du plan)
  commissionEarned Float?   // Commission calculée
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  commissions     Commission[]
  
  @@index([affiliateId])
  @@index([referredUserId])
  @@index([referralCode])
  @@index([status])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

model Commission {
  id              String    @id @default(cuid())
  affiliateId     String
  affiliate       Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referralId      String?   // Peut être null pour les commissions manuelles
  referral        Referral? @relation(fields: [referralId], references: [id], onDelete: SetNull)
  
  // Détails de la commission
  amount          Float
  type            CommissionType @default(REFERRAL) // REFERRAL, BONUS, MANUAL
  status          CommissionStatus @default(PENDING) // PENDING, PAID, CANCELLED
  
  // Stripe
  stripeTransferId String?  // ID du transfert Stripe
  stripePaymentIntentId String? // ID du paiement Stripe
  stripeSubscriptionId String? // ID de l'abonnement Stripe
  
  // Paiement
  paidAt          DateTime?
  paymentMethod   String?   // "stripe_transfer", "stripe_connect"
  paymentReference String?  // Référence du paiement
  
  // Métadonnées
  description     String?
  notes           String?   @db.Text
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([affiliateId])
  @@index([status])
  @@index([type])
  @@index([stripeTransferId])
}

// Enums pour le système d'affiliation
enum AffiliateStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum ReferralStatus {
  PENDING
  CONVERTED
  EXPIRED
}

enum ConversionType {
  SIGNUP
  UPGRADE
  PAYMENT
}

enum CommissionType {
  REFERRAL
  BONUS
  MANUAL
}

enum CommissionStatus {
  PENDING
  PAID
  CANCELLED
}